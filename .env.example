# Security Secrets
# You can generate a strong random string using: openssl rand -base64 32
# or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-string
REFRESH_TOKEN_SECRET=change-me-to-another-strong-random-string

# Admin Operator Account
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=admin123

# API & Frontend URLs
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
# Base URL path for Vite frontend build (e.g. / for root, /hellomyphotos-photobooth/ for subpath)
VITE_BASE_URL=/

# Security & Cookie Settings
# Domain name for cookies (e.g., example.com) — leave empty for localhost
COOKIE_DOMAIN=example.com
# Base path if the server is hosted in a subfolder (e.g., /hellomyphotos-photobooth)
COOKIE_PATH=/
# SameSite policy: strict (default), lax, or none (required for cross-site requests)
COOKIE_SAME_SITE=strict
# Force secure cookies (HTTPS required); automatically true when NODE_ENV=production
COOKIE_SECURE=true
