{
  "name": "hellomyphoto-server",
  "version": "3.0.0",
  "private": true,
  "description": "Self-hosted photo booth system - Operator Hub",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "vite --config vite.config.ts",
    "build": "tsc && vite build --config vite.config.ts",
    "start": "node dist/src/server.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "sharp": "^0.33.2",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.5",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-vue": "^5.0.3",
    "axios": "^1.6.5",
    "pinia": "^2.1.7",
    "qrcode.vue": "^3.4.1",
    "socket.io-client": "^4.7.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "vue-tsc": "^1.8.27"
  }
}
